# Pipeline settings (python -m pipeline). In GitHub Actions these are
# repository secrets with the same names. Never commit real values.

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) account id, only if the accounts are accessed through one.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# COMPTE=customer id; several ids per compte are allowed.
GOOGLE_ADS_ACCOUNTS=ALM=123-456-7890,CPA=098-765-4321

# Meta Marketing API (system user token with ads_read)
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNTS=ALM=act_1234567890,CPA=act_0987654321

# Supabase (service-role key or sb_secret_... key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
